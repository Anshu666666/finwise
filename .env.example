# ==============================================================================
# FINWISE AI – ENVIRONMENT CONFIGURATION (STEP 2: ZAID)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env  (or copy .env.example .env on Windows)
# 2. Add your OpenRouter API key below.
# 3. NEVER commit your real .env file with secrets into version control!
# ==============================================================================

# OpenRouter LLM Configuration
# Set OPENROUTER_MODEL=openrouter/free to use OpenRouter's Free Models Router (auto-routing to available free models at zero cost)
# Or specify a specific free model variant like 'meta-llama/llama-3.2-3b-instruct:free'
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60

# Live Web Search Configuration
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=15
